# Server
NODE_ENV=production
PORT=8000

# Database (host = compose service name "postgres")
DATABASE_URL=postgresql://rf_user:CHANGE_ME_STRONG@postgres:5432/rf_studio
POSTGRES_USER=rf_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=rf_studio

# Redis (host = compose service name "redis")
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM_64_CHARS
JWT_EXPIRES_IN=7d

# Upload / public URLs (must be the HTTPS domain)
PUBLIC_BASE_URL=https://api.rfstudio.com
ASSETS_DIR=assets

# Feature flags
FEATURE_FLAGS_PATH=feature-flags.json

# Traefik / ACME
ACME_EMAIL=you@example.com
APP_DOMAIN=api.rfstudio.com