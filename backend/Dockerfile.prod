# ---- Build stage ----
FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

# ---- Runtime stage ----
FROM node:22-alpine AS runtime
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app
ENV NODE_ENV=production

# Full deps so drizzle-kit is available for migrate-on-boot.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# App bundle + everything migrations need at runtime.
COPY --from=builder /app/dist ./dist
COPY drizzle.config.ts ./drizzle.config.ts
COPY src/infrastructure/db/migrations ./src/infrastructure/db/migrations
COPY src/infrastructure/db/schema ./src/infrastructure/db/schema
COPY feature-flags.json ./feature-flags.json
COPY tools/docker-entrypoint.prod.sh ./tools/docker-entrypoint.prod.sh

RUN sed -i 's/\r$//' tools/docker-entrypoint.prod.sh && chmod +x tools/docker-entrypoint.prod.sh

EXPOSE 8000
CMD ["./tools/docker-entrypoint.prod.sh"]